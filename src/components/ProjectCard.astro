---
interface Props {
  title: string;
  outcome: string;
  stack: string;
  href: string;
}
const { title, outcome, stack, href } = Astro.props;
const external = href.startsWith('http');
---
<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  class="block rounded-xl border border-neutral-200 p-6 transition hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-600"
>
  <h3 class="text-lg font-semibold">{title}</h3>
  <p class="mt-2 text-neutral-600 dark:text-neutral-400">{outcome}</p>
  <p class="mt-4 text-xs uppercase tracking-wide text-neutral-500">{stack}</p>
</a>
